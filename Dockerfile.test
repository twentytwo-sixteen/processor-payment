FROM payment-processor:local
USER root
RUN uv sync --frozen
COPY --from=docker:29.4.0-cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker:29.4.0-cli /usr/local/libexec/docker/cli-plugins/docker-compose /usr/local/libexec/docker/cli-plugins/docker-compose
COPY tests ./tests
COPY scripts ./scripts
COPY docker ./docker
CMD ["pytest", "tests"]
